From: Valid, Frozen, Missing
To: Valid, Missing, SameAsFrom, FrozenTo
Amount: Normal, Negative, Zero, MinPositive, AtLimit, OverLimit, AtBalance, OverBalance, OverLimitAfterConv
Currency: Same, MNT, EUR
DailyLimit: Free, Partial, Full
Balance: Positive, Zero

# Only meaningful boundary pairings; leave deliberate double faults for testing.
IF [Amount] = "OverLimitAfterConv" THEN [Currency] = "EUR";
IF [Amount] = "AtLimit" THEN [DailyLimit] = "Free" AND [Currency] = "Same" AND [Balance] = "Positive";
IF [Amount] = "AtBalance" THEN [DailyLimit] = "Free" AND [Currency] = "Same" AND [Balance] = "Positive";
IF [Amount] = "MinPositive" THEN [Currency] = "Same";
IF [To] = "SameAsFrom" THEN [From] <> "Missing";
